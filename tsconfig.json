{
  // lib ES2016: o typecheck recusa API que o Chromium 53 da TV não tem (Object.entries, padStart,
  // AbortController, replaceAll…). A sintaxe nova (async, ?., ??, spread) é rebaixada pelo esbuild
  // (target chrome53, scripts/build.mjs).
  "compilerOptions": {
    "target": "ES2016",
    "lib": ["ES2016", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
